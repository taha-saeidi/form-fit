{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "formfit",
  "main": "worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "formfit",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://formfit.YOUR-SUBDOMAIN.workers.dev",
    "ALLOW_REGISTRATION": "true",
    "GOOGLE_CLIENT_ID": ""
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "0 3 * * *"
    ]
  }
}
